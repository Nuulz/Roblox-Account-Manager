{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roblox Account Manager",
  "version": "4.2.0",
  "identifier": "com.nuulz.robloxaccountmanager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Roblox Account Manager",
        "width": 915,
        "height": 347,
        "minWidth": 760,
        "minHeight": 330,
        "center": true,
        "backgroundColor": "#1e1e1e",
        "dragDropEnabled": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https://*.rbxcdn.com https://*.roblox.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Nuulz",
    "copyright": "GPL-3.0 - Nuulz",
    "category": "Utility",
    "shortDescription": "Roblox Account Manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}